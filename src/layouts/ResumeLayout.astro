---
import "@/styles/global.css";
import "@/styles/typography.css";
import Head, { type Props as HeadProps } from "@/components/static/Head.astro";

interface Props extends HeadProps {
  lang?: "zh" | "en";
}

const { lang = "en", ...headProps } = Astro.props as Props;
const locale = lang === "zh" ? "zh_CN" : "en_US";
---

<!doctype html>
<html lang={lang}>
  <Head {...headProps} locale={locale} />

    <body class="mx-auto">
        {/* Content */}
        <main class="max-w-4xl mx-auto">
            <slot />
        </main>
    </body>
</html>

---
import { RiCalendar2Line, RiMailLine, RiMapPin2Line, RiGlobalLine, RiLinkedinBoxLine, RiGithubLine, RiTwitterLine, RiExternalLinkLine, RiPhoneLine } from "@remixicon/react";

interface Props {
  data: {
    profile: any;
    sections: any;
    labels: any;
  };
}

const { data } = Astro.props;
const { profile, sections, labels } = data;

const formatDate = (date: string) => {
  if (date === "Present") return "Present";
  return new Date(date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
  });
};

const locationStr = `${profile.location.city}, ${profile.location.state}`;

// Compact styling for the markdown-rendered body inside each resume entry.
const mdClass =
  "resume-md text-sm leading-relaxed text-foreground/70 space-y-1.5 " +
  "[&_h2]:text-xs [&_h2]:font-mono [&_h2]:uppercase [&_h2]:tracking-[0.15em] [&_h2]:text-muted-foreground [&_h2]:mt-4 [&_h2]:mb-2 " +
  "[&_p]:text-sm [&_p]:leading-relaxed [&_p]:text-foreground/70 " +
  "[&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mt-1 [&_ul]:mb-1 [&_ul]:space-y-1 " +
  "[&_li]:text-sm [&_li]:leading-relaxed [&_li]:text-foreground/70 " +
  "[&_strong]:font-semibold [&_strong]:text-foreground";
---

<div class="my-10 p-6 space-y-14 border border-border">
  <!-- Header -->
  <header class="space-y-5">
    <div>
      <h1 class="text-5xl font-semibold tracking-tight">{profile.name}</h1>
      <p class="text-xl text-muted-foreground mt-1.5">{profile.profession}</p>
    </div>

    <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted-foreground">
      <a href={`mailto:${profile.email}`} class="inline-flex items-center gap-1.5 hover:text-foreground animation">
        <RiMailLine className="size-4" />
        {profile.email}
      </a>
      {profile.phone && (
        <a href={`tel:${profile.phone.replace(/\s/g, "")}`} class="inline-flex items-center gap-1.5 hover:text-foreground animation">
          <RiPhoneLine className="size-4" />
          {profile.phone}
        </a>
      )}
      <span class="inline-flex items-center gap-1.5">
        <RiMapPin2Line className="size-4" />
        {locationStr}
      </span>
      <a href={profile.website} target="_blank" class="inline-flex items-center gap-1.5 hover:text-foreground animation">
        <RiGlobalLine className="size-4" />
        {profile.website.replace("https://", "")}
      </a>
    </div>

    <div class="flex gap-4">
      {
        profile.socials.map(
          (s) =>
            ({
              linkedin: (
                <a href={s.url} target="_blank" class="text-muted-foreground hover:text-foreground animation" aria-label="linkedin">
                  <RiLinkedinBoxLine className="size-5" />
                </a>
              ),
              github: (
                <a href={s.url} target="_blank" class="text-muted-foreground hover:text-foreground animation" aria-label="github">
                  <RiGithubLine className="size-5" />
                </a>
              ),
              twitter: (
                <a href={s.url} target="_blank" class="text-muted-foreground hover:text-foreground animation" aria-label="twitter">
                  <RiTwitterLine className="size-5" />
                </a>
              ),
            })[s.platform],
        )
      }
    </div>
  </header>

  <!-- Summary -->
  <section>
    <div class="flex items-center gap-3 mb-5">
      <span class="text-xs font-mono tracking-[0.15em] text-muted-foreground">{labels.summary}</span>
      <div class="flex-1 border-t border-border"></div>
    </div>
    <p class="text-base leading-relaxed text-foreground/80">
      {profile.summary}
    </p>
  </section>

  <!-- Experience -->
  {
    sections.experience.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs font-mono tracking-[0.15em] text-muted-foreground">{labels.experience}</span>
          <div class="flex-1 border-t border-border"></div>
        </div>
        <div class="space-y-8">
          {
            sections.experience.map(({ data: exp, Content }) => (
              <div class="border-l-2 border-border pl-5 space-y-3">
                <div>
                  <h3 class="text-lg font-medium">{exp.position}</h3>
                  <p class="text-sm text-muted-foreground mt-0.5">
                    {exp.organization}
                    <span class="mx-2">·</span>
                    <span class="inline-flex items-center gap-1">
                      <RiCalendar2Line className="size-3.5" />
                      {formatDate(exp.startDate)} - {formatDate(exp.endDate)}
                    </span>
                    <span class="mx-2">·</span>
                    {exp.location}
                  </p>
                </div>
                <div class={mdClass}>
                  <Content />
                </div>
              </div>
            ))
          }
        </div>
      </section>
    )
  }

  <!-- Education -->
  {
    sections.education.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs font-mono tracking-[0.15em] text-muted-foreground">{labels.education}</span>
          <div class="flex-1 border-t border-border"></div>
        </div>
        <div class="space-y-6">
          {
            sections.education.map(({ data: edu, Content }) => (
              <div class="border-l-2 border-border pl-5 space-y-2">
                <div>
                  <h3 class="text-lg font-medium">{edu.institution}</h3>
                  <p class="text-sm text-muted-foreground mt-0.5">
                    {edu.degree} in {edu.fieldOfStudy}
                    <span class="mx-2">·</span>
                    <span class="inline-flex items-center gap-1">
                      <RiCalendar2Line className="size-3.5" />
                      {formatDate(edu.startDate)} - {formatDate(edu.endDate)}
                    </span>
                  </p>
                </div>
                {edu.grade && <p class="text-sm text-foreground/70">GPA: {edu.grade}</p>}
                <div class={mdClass}>
                  <Content />
                </div>
              </div>
            ))
          }
        </div>
      </section>
    )
  }

  <!-- Skills (kept in resume-config.json as simple profile data) -->
  {
    profile.skills?.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs font-mono tracking-[0.15em] text-muted-foreground">{labels.skills}</span>
          <div class="flex-1 border-t border-border"></div>
        </div>
        <div class="space-y-4">
          {
            profile.skills.map((skill) => (
              <div class="flex items-start gap-4">
                <span class="text-sm font-medium text-foreground w-36 shrink-0">{skill.name}</span>
                <div class="flex flex-wrap gap-1.5">
                  {skill.tags.map((t) => (
                    <span class="inline-flex items-center rounded-full border border-border bg-muted/50 px-2.5 py-0.5 text-[11px] font-medium text-muted-foreground">{t}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    )
  }

  <!-- Projects -->
  {
    sections.projects.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs font-mono tracking-[0.15em] text-muted-foreground">{labels.projects}</span>
          <div class="flex-1 border-t border-border"></div>
        </div>
        <div class="space-y-6">
          {
            sections.projects.map(({ data: proj, Content }) => (
              <div class="border-l-2 border-border pl-5 space-y-2">
                <div class="flex items-center gap-2">
                  <h3 class="text-lg font-medium">{proj.name}</h3>
                  {proj.url && (
                    <a href={proj.url} target="_blank" class="text-muted-foreground hover:text-foreground animation" aria-label="project link">
                      <RiExternalLinkLine className="size-4" />
                    </a>
                  )}
                </div>
                {(proj.role || proj.startDate || proj.endDate) && (
                  <p class="text-sm text-muted-foreground">
                    {proj.role && <span>{proj.role}</span>}
                    {proj.role && (proj.startDate || proj.endDate) && <span class="mx-2">·</span>}
                    {proj.startDate && (
                      <span class="inline-flex items-center gap-1">
                        <RiCalendar2Line className="size-3.5" />
                        {formatDate(proj.startDate)} - {formatDate(proj.endDate)}
                      </span>
                    )}
                  </p>
                )}
                <div class={mdClass}>
                  <Content />
                </div>
              </div>
            ))
          }
        </div>
      </section>
    )
  }

  <!-- Certifications -->
  {
    sections.certifications.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs font-mono tracking-[0.15em] text-muted-foreground">{labels.certifications}</span>
          <div class="flex-1 border-t border-border" />
        </div>
        <div class="space-y-4">
          {
            sections.certifications.map(({ data: cert, Content }) => (
              <div class="border-l-2 border-border pl-5 space-y-2">
                <div class="flex items-center justify-between gap-4">
                  <div>
                    <h3 class="text-base font-medium">{cert.name}</h3>
                    <p class="text-sm text-muted-foreground">{cert.issuer}</p>
                  </div>
                  <span class="text-sm text-muted-foreground shrink-0">{formatDate(cert.date)}</span>
                </div>
                <div class={mdClass}>
                  <Content />
                </div>
              </div>
            ))
          }
        </div>
      </section>
    )
  }

  <!-- Volunteering -->
  {
    sections.volunteering.length > 0 && (
      <section>
        <div class="flex items-center gap-3 mb-6">
          <span class="text-xs font-mono tracking-[0.15em] text-muted-foreground">{labels.volunteering}</span>
          <div class="flex-1 border-t border-border" />
        </div>
        <div class="border-l-2 border-border pl-5 space-y-4">
          {
            sections.volunteering.map(({ data: v, Content }) => (
              <div>
                <h3 class="text-base font-medium">{v.organization}</h3>
                <p class="text-sm text-muted-foreground">
                  {v.position}
                  <span class="mx-2">·</span>
                  <span class="inline-flex items-center gap-1">
                    <RiCalendar2Line className="size-3.5" />
                    {formatDate(v.startDate)} - {formatDate(v.endDate)}
                  </span>
                </p>
                <div class={`${mdClass} mt-1`}>
                  <Content />
                </div>
              </div>
            ))
          }
        </div>
      </section>
    )
  }
</div>
---
import { RiCalendar2Line, RiWallet3Line } from "@remixicon/react";
import BackButton from "../static/BackButton.astro";
import ShareButton from "../client/ShareButton.tsx";
import {
    GEAR_ACQUIRED_VIA_LABELS,
    GEAR_CATEGORY_LABELS,
    GEAR_STATUS_LABELS,
    GEAR_VERDICT_LABELS,
    formatAcquired,
    formatPrice,
    formatUpdated,
} from "@/lib/gear";
import type { gearConfig } from "@/lib/types";

const { items } = Astro.props as { items: gearConfig["data"] };

const categoryLabel = GEAR_CATEGORY_LABELS[items.category];
const statusLabel = GEAR_STATUS_LABELS[items.status];
const verdictLabel = GEAR_VERDICT_LABELS[items.verdict];
const acquiredLabel = formatAcquired(items.acquired);
const priceLabel = formatPrice(items.price, items.currency);
const updatedLabel = formatUpdated(items.updated);
const acquiredViaLabel = items.acquiredVia ? GEAR_ACQUIRED_VIA_LABELS[items.acquiredVia] : "";
---

<div class="border border-border mt-10 p-6">
    <BackButton url="/gear" />

    <header class="mt-3 select-none">
        <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
            <span class="px-2 py-0.5 border border-muted-foreground/30 rounded uppercase tracking-widest">
                {categoryLabel}
            </span>
            <span class="px-2 py-0.5 border border-border bg-muted rounded">
                {statusLabel}
            </span>
            <span class="px-2 py-0.5 border border-border bg-muted rounded">
                {verdictLabel}
            </span>
            {acquiredViaLabel && <span class="text-muted-foreground/70">{acquiredViaLabel}</span>}
        </div>

        <h1 class="text-5xl font-semibold opacity-90 mt-4">{items.title}</h1>
        <p class="text-lg text-muted-foreground mt-3">{items.description}</p>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-4 text-sm text-muted-foreground">
            <div class="flex items-center gap-2">
                <RiCalendar2Line className="size-4" />
                <span>{acquiredLabel} 起使用</span>
            </div>
            {priceLabel && (
                <div class="flex items-center gap-2">
                    <RiWallet3Line className="size-4" />
                    <span>{priceLabel}</span>
                </div>
            )}
            <div class="ml-auto">
                <ShareButton client:load />
            </div>
        </div>

        {updatedLabel && (
            <p class="mt-2 text-xs text-muted-foreground/70">最后复核于 {updatedLabel}</p>
        )}

        {
            items.tags && items.tags.length > 0 && (
                <div class="flex gap-2 mt-4 flex-wrap">
                    {items.tags.map((tag: string) => (
                        <span class="text-xs px-3 py-1 bg-muted text-muted-foreground rounded">{tag}</span>
                    ))}
                </div>
            )
        }
    </header>
</div>

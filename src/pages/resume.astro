---
import ResumeLayout from "@/layouts/ResumeLayout.astro";
import ResumeBody from "@/components/static/ResumeBody.astro";
import resume from "@/resume-config.json";
import { localizeData } from "@/lib/translate";
import { loadResumeSection } from "@/lib/resume";

const lang = "zh";

const localized = localizeData(resume, lang);
const { labels, ...profile } = localized;

const sections = {
  experience: await loadResumeSection("resume-experience", lang, "desc"),
  projects: await loadResumeSection("resume-projects", lang, "desc"),
  education: await loadResumeSection("resume-education", lang),
  volunteering: await loadResumeSection("resume-volunteering", lang),
  certifications: await loadResumeSection("resume-certifications", lang),
};
---

<ResumeLayout title="简历" description={profile.summary} image="/og/default.png" lang="zh">
  <div class="flex justify-end p-4">
    <a href="/resume.en" class="px-3 py-1 text-xs border rounded hover:bg-zinc-100">English 🇬🇧</a>
  </div>
  <ResumeBody data={{ profile, sections, labels }} />
</ResumeLayout>
